# 이 파일을 저장소 루트의 .env로 복사하고 python run.py로 실행합니다.
# 이미 설정한 운영체제 환경 변수가 이 파일보다 우선합니다.

# 지정한 원본 파이프라인: 카탈로그 + 연도별 RAW 자료
ADDRESS_CATALOG=data/address_reference_lite/address_catalog.duckdb
ADDRESS_RAW_DIR=data
ADDRESS_YEAR=2025
# 과거 자료가 없으면 ADDRESS_HISTORY= 로 비워 기준연도만 사용합니다.
ADDRESS_HISTORY=2024,2023
ADDRESS_BATCH_SIZE=480
ADDRESS_INPUT_CLEANUP=1
ADDRESS_DETAIL_RECOVERY=0

# 실제 파이프라인은 LLM 파서가 필요합니다: openai 또는 ollama
ADDRESS_PARSER=openai
# Ollama를 선택한 경우 설치한 모델 태그를 지정하고 로컬 서버를 실행합니다.
ADDRESS_OLLAMA_MODEL=qwen3:1.7b

# 파이프라인(OpenAI 선택 시)·BigQuery 교정·워크벤치 추가 분석 공통 설정
OPENAI_API_KEY=
OPENAI_MODEL=
# 별도 OpenAI dotenv 파일을 쓸 경우에만 지정합니다.
# ADDRESS_OPENAI_ENV=/absolute/path/to/openai.env

# BigQuery 엔진을 쓸 때만 실제 프로젝트로 변경합니다.
ADDRESS_BQ_PROJECT=your-gcp-project
ADDRESS_BQ_DATASET=address
ADDRESS_BQ_LOCATION=asia-northeast3
# BigQuery의 선택적 AI 교정 (파이프라인의 필수 LLM 파서와 별개)
ADDRESS_BQ_AI=0
ADDRESS_BQ_AI_PROVIDER=openai
ADDRESS_BQ_AI_MAX=3000
# 기본은 gcloud auth application-default login으로 만든 인증을 사용합니다.
# 서비스 계정을 쓰는 경우에만 JSON 경로를 지정하며 파일은 저장소에 올리지 마세요.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
