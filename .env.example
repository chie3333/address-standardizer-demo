# 이 파일을 저장소 루트의 .env로 복사하고 python run.py로 실행합니다.
# 이미 설정한 운영체제 환경 변수가 이 파일보다 우선합니다.

# 새 파이프라인: 별도로 준비한 기준자료의 경로 (루트 기준 상대 경로 또는 절대 경로)
ADDRESS_RAW_PARQUET=data/RAW_DATA_2025.parquet
ADDRESS_HISTORY_PARQUET=data/ADDRESS_HISTORY_202410_202512.parquet
ADDRESS_PIPELINE_MEMORY=4GB

# 처음에는 AI 교정을 끈 상태로 실행합니다. AI를 쓰려면 1로 바꾸고 아래 키·모델을 채우세요.
ADDRESS_PIPELINE_LLM=0
ADDRESS_PIPELINE_LLM_MAX=3000
ADDRESS_BQ_AI=0
ADDRESS_BQ_AI_PROVIDER=openai
ADDRESS_BQ_AI_MAX=3000

# 파이프라인·BigQuery 교정·워크벤치 추가 분석이 공통으로 사용하는 OpenAI 설정
# OPENAI_MODEL에는 본인 계정에서 사용할 모델 이름을 입력합니다.
OPENAI_API_KEY=
OPENAI_MODEL=
# 별도 OpenAI 설정 파일을 쓰는 경우에만 지정 (OPENAI_API_KEY와 OPENAI_MODEL을 담은 dotenv 파일)
# ADDRESS_OPENAI_ENV=/absolute/path/to/openai.env

# BigQuery 엔진을 쓸 때만 실제 프로젝트로 변경합니다.
ADDRESS_BQ_PROJECT=your-gcp-project
ADDRESS_BQ_DATASET=address
ADDRESS_BQ_LOCATION=asia-northeast3
# 기본은 gcloud auth application-default login으로 만든 인증을 사용합니다.
# 서비스 계정을 쓰는 경우에만 JSON 경로를 지정합니다. 인증 파일은 저장소에 올리지 마세요.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
